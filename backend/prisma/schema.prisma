generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int                 @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  archivedAt  DateTime?
  memberships ProjectMembership[]
  invitations ProjectInvitation[]
  tasks       Task[]
  tags        ProjectTag[]
}

model ProjectMembership {
  projectId Int
  userId    String
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, role])
}

model ProjectInvitation {
  id              Int              @id @default(autoincrement())
  projectId       Int
  inviterId       String
  email           String
  normalizedEmail String
  role            ProjectRole
  status          InvitationStatus @default(pending)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter         User             @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail, status, expiresAt])
  @@index([projectId, normalizedEmail, status])
}

model Tag {
  id             Int       @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]

  @@unique([userId, normalizedName])
}

model ProjectTag {
  id             Int              @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  projectId      Int
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTags       ProjectTaskTag[]

  @@unique([projectId, normalizedName])
}

model Task {
  id              Int              @id @default(autoincrement())
  title           String
  description     String?
  status          TaskStatus
  priority        TaskPriority
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderIndex      Int              @default(0)
  projectId       Int?
  createdById     String
  assigneeId      String?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("TasksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee        User?            @relation("TasksAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  taskTags        TaskTag[]
  projectTaskTags ProjectTaskTag[]
  checklistItems  ChecklistItem[]

  @@index([createdById, projectId])
  @@index([assigneeId, projectId])
}

model ChecklistItem {
  id         Int     @id @default(autoincrement())
  text       String
  completed  Boolean @default(false)
  orderIndex Int     @default(0)
  taskId     Int
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, orderIndex])
}

model TaskTag {
  taskId Int
  tagId  Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model ProjectTaskTag {
  taskId Int
  tagId  Int
  tag    ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model User {
  id                String              @id
  fname             String?
  lname             String?
  primaryEmail      String?
  imageUrl          String?
  createdAt         DateTime            @default(now())
  memberships       ProjectMembership[]
  invitationsSent   ProjectInvitation[] @relation("InvitedBy")
  emails            UserEmail[]
  tags              Tag[]
  tasksCreated      Task[]              @relation("TasksCreated")
  tasksAssigned     Task[]              @relation("TasksAssigned")
  aiGenerationLimit AiGenerationLimit?
}

model UserEmail {
  id              Int     @id @default(autoincrement())
  userId          String
  email           String
  normalizedEmail String
  primary         Boolean @default(false)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedEmail])
  @@index([normalizedEmail])
}

model AiGenerationLimit {
  userId          String   @id
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  completed
}
