generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                       Int                 @id @default(autoincrement())
  title                    String
  description              String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  archivedAt               DateTime?
  editorsCanCreateTasks    Boolean             @default(true)
  editorsCanAssignOthers   Boolean             @default(true)
  editorsCanEditAllTasks   Boolean             @default(true)
  editorsCanJoinTasks      Boolean             @default(true)
  editorsCanLeaveTasks     Boolean             @default(true)
  memberships              ProjectMembership[]
  invitations              ProjectInvitation[]
  tasks                    Task[]
  tags                     ProjectTag[]
  notifications            Notification[]
  activities               ProjectActivity[]
}

model ProjectMembership {
  projectId Int
  userId    String
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, role])
}

model ProjectInvitation {
  id              Int              @id @default(autoincrement())
  projectId       Int
  inviterId       String
  email           String
  normalizedEmail String
  role            ProjectRole
  status          InvitationStatus @default(pending)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter         User             @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail, status, expiresAt])
  @@index([projectId, normalizedEmail, status])
}

model Tag {
  id             Int       @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]

  @@unique([userId, normalizedName])
}

model ProjectTag {
  id             Int              @id @default(autoincrement())
  name           String
  normalizedName String
  color          String
  projectId      Int
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTags       ProjectTaskTag[]

  @@unique([projectId, normalizedName])
}

model Task {
  id              Int              @id @default(autoincrement())
  title           String
  description     String?
  status          TaskStatus
  priority        TaskPriority
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderIndex      Int              @default(0)
  projectId       Int?
  createdById     String
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("TasksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignments     TaskAssignment[]
  taskTags        TaskTag[]
  projectTaskTags ProjectTaskTag[]
  checklistItems  ChecklistItem[]
  comments        TaskComment[]
  activities      ProjectActivity[]
  notifications   Notification[]

  @@index([createdById, projectId])
}

model TaskAssignment {
  taskId     Int
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, taskId])
}

model ChecklistItem {
  id         Int     @id @default(autoincrement())
  text       String
  completed  Boolean @default(false)
  orderIndex Int     @default(0)
  taskId     Int
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, orderIndex])
}

model TaskTag {
  taskId Int
  tagId  Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model ProjectTaskTag {
  taskId Int
  tagId  Int
  tag    ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model User {
  id                String              @id
  fname             String?
  lname             String?
  primaryEmail      String?
  imageUrl          String?
  createdAt         DateTime            @default(now())
  memberships       ProjectMembership[]
  invitationsSent   ProjectInvitation[] @relation("InvitedBy")
  emails            UserEmail[]
  tags              Tag[]
  tasksCreated      Task[]              @relation("TasksCreated")
  taskAssignments   TaskAssignment[]
  commentsAuthored  TaskComment[]        @relation("CommentAuthor")
  commentsDeleted   TaskComment[]        @relation("CommentDeletedBy")
  commentMentions   CommentMention[]
  activities        ProjectActivity[]    @relation("ActivityActor")
  aiGenerationLimit AiGenerationLimit?
  notifications     Notification[]        @relation("NotificationRecipient")
  notificationActs  Notification[]        @relation("NotificationActor")
}

model TaskComment {
  id          Int              @id @default(autoincrement())
  taskId      Int
  authorId    String
  body        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy   User?            @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  mentions    CommentMention[]

  @@index([taskId, createdAt, id])
}

model CommentMention {
  commentId Int
  userId    String
  start     Int
  end       Int
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, start])
  @@index([userId, commentId])
}

model ProjectActivity {
  id        Int                 @id @default(autoincrement())
  projectId Int
  taskId    Int?
  actorId   String?
  type      ProjectActivityType
  metadata  Json
  createdAt DateTime            @default(now())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor     User?               @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt, id])
  @@index([taskId, createdAt, id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  actorId   String?
  projectId Int?
  taskId    Int?
  type      NotificationType
  metadata  Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model UserEmail {
  id              Int     @id @default(autoincrement())
  userId          String
  email           String
  normalizedEmail String
  primary         Boolean @default(false)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedEmail])
  @@index([normalizedEmail])
}

model AiGenerationLimit {
  userId          String   @id
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

enum NotificationType {
  task_assigned
  task_unassigned
  task_commented
  comment_mentioned
  role_changed
  project_removed
  ownership_transferred
}

enum ProjectActivityType {
  task_created
  task_status_changed
  task_assignees_changed
  comment_created
  comment_edited
  comment_deleted
  member_joined
  member_removed
  member_role_changed
  ownership_transferred
  project_settings_updated
  project_archived
  project_restored
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  completed
}
